# Gom Hoa Sen - production / Dokploy environment template
# Dokploy: set these as compose environment variables (never commit real values).
# Bare-metal: copy to /var/www/gomhoasen/shared/.env and chmod 600.

NODE_ENV=production
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
GHS_APPLICATION_SCOPE_ID=gomhoasen

CORS_ORIGIN=https://gomhoasen.vn,https://www.gomhoasen.vn

# Docker compose service hostname is "mongo". Bare metal uses 127.0.0.1.
# MongoDB must run as a replica set because quote creation uses transactions.
MONGODB_URI=mongodb://mongo:27017/ghs_production?replicaSet=rs0

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRY=7d

# Used only for first seed or an explicit password reset.
ADMIN_SEED_EMAIL=admin@gomhoasen.vn
ADMIN_SEED_PASSWORD=CHANGE_ME_TO_A_FIXED_PASSWORD_OF_AT_LEAST_12_CHARACTERS
ADMIN_SEED_NAME=Gom Hoa Sen Admin

# Docker volume mount; bare metal: /var/www/gomhoasen/uploads
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_IMAGE_SIZE=5242880
UPLOAD_MAX_MODEL_SIZE=20971520

# Public browser URLs are same-origin in production.
NEXT_PUBLIC_API_URL=/api
VITE_API_URL=/api
VITE_UPLOAD_URL=
VITE_SITE_URL=https://gomhoasen.vn

# Required for sending quotes by email.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Gom Hoa Sen <no-reply@gomhoasen.vn>"

PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Dokploy compose helpers
REGISTRY_IMAGE=ghcr.io/kadiesnguyen/gomsuhoasen
IMAGE_TAG=latest
WEB_PUBLISH_PORT=8088
