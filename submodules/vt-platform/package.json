{
  "name": "vt-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "scan:package-boundaries": "node scripts/package-boundary-scan.mjs",
    "scan:cross-project": "node scripts/cross-project-pattern-scan.mjs",
    "scan:cross-project:required": "node scripts/cross-project-pattern-scan.mjs --require-roots",
    "scan:dependency-drift": "node scripts/cross-project-dependency-drift-scan.mjs",
    "scan:dependency-drift:required": "node scripts/cross-project-dependency-drift-scan.mjs --require-roots",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:nodenext",
    "typecheck:nodenext": "tsc -p packages/platform-api-contract/tsconfig.nodenext.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:vitest": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/testing": "^11.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.0",
    "bcrypt": "^6.0.0",
    "cron-parser": "^4.9.0",
    "enhanced-resolve": "^5.19.0",
    "jsdom": "~22.1.0",
    "lucide-react": "^0.575.0",
    "mongoose": "^9.2.0",
    "nestjs-cls": "^6.2.0",
    "nodemailer": "^8.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tsx": "^4.19.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.0",
    "@nestjs/axios": "^4.0.1",
    "axios": "^1.13.5",
    "ipaddr.js": "^2.4.0"
  }
}
