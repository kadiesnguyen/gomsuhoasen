{
  "name": "showroom_v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/showroom_v2/src",
  "projectType": "application",
  "tags": ["type:app", "scope:showroom"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/showroom_v2",
        "configFile": "apps/showroom_v2/vite.config.ts",
        "tsConfig": "apps/showroom_v2/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "showroom_v2:build",
        "configFile": "apps/showroom_v2/vite.config.ts",
        "port": 4313
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/run-tsc.cjs -p apps/showroom_v2/tsconfig.app.json --noEmit"
      }
    }
  }
}
