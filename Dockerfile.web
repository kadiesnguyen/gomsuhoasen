# Gốm Hoa Sen web — showroom_v2 + portal static, NGINX front
FROM node:20-bookworm-slim AS deps
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit --progress=false

FROM deps AS builder
WORKDIR /app
COPY . .
ENV VITE_API_URL=/api \
    NEXT_PUBLIC_API_URL=/api \
    PUPPETEER_SKIP_DOWNLOAD=true
RUN npx nx run-many -t build --projects=portal,showroom_v2 --skip-nx-cache

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/apps/showroom_v2 /usr/share/nginx/html/showroom
COPY --from=builder /app/dist/apps/portal /usr/share/nginx/html/admin
RUN mkdir -p /var/www/uploads
EXPOSE 80
